# Local dev — Vite proxies /api → backend
VITE_API_PREFIX=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# WebSocket — FE connect qua Vite proxy /socket.io → socket service :6001
# Dev: để trống VITE_SOCKET_URL hoặc dùng origin Vite (localhost:3000)
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PROXY_TARGET=http://127.0.0.1:6001
