# API prefix (default /api if unset). Production uses same-origin /api/* — no full URL needed.
VITE_API_PREFIX=/api

# Local dev only — Vite proxy target (Laravel origin without /api suffix)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# WebSocket — import Excel notifications
# Dev: VITE_SOCKET_URL = origin Vite (proxy /socket.io → socket :6001)
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PROXY_TARGET=http://127.0.0.1:6001

# Production example (nginx proxy /socket.io → socket service):
# VITE_SOCKET_URL=https://your-domain.com
