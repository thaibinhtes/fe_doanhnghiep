# API prefix (default /api if unset). Production uses same-origin /api/* — no full URL needed.
VITE_API_PREFIX=/api

# Local dev only — Vite proxy target (dùng 127.0.0.1, KHÔNG dùng localhost nếu Docker cũng bind :8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# WebSocket — import Excel notifications
# Dev: connect trực tiếp socket :3001 (hoặc proxy qua Vite nếu VITE_SOCKET_URL = origin Vite)
VITE_SOCKET_URL=http://localhost:3001
VITE_SOCKET_PROXY_TARGET=http://127.0.0.1:3001

# Production example (nginx proxy /socket.io → socket service):
# VITE_SOCKET_URL=https://your-domain.com
