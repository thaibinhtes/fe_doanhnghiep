# Production nginx — qldn.zsellers.com (FE + proxy /api → backend :8000)
#
# Lỗi "upload_max_filesize=2M" KHÔNG do FE nginx — do PHP backend chưa 520M.
# Kiểm tra: curl -s https://qldn.zsellers.com/api/health | jq .data.php
# Phải thấy uploadMaxFilesize: "520M". Nếu vẫn 2M → rebuild backend Docker.
#
# Reload: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 443 ssl http2;
    server_name qldn.zsellers.com;

    ssl_certificate /etc/letsencrypt/live/qldn.zsellers.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qldn.zsellers.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 520m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # ── Backend API (Laravel :8000) ─────────────────────────────────────
    location /api {
        client_max_body_size 520m;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Upload Excel lớn — không buffer body trước khi gửi backend
        proxy_request_buffering off;
        proxy_connect_timeout 600s;
        proxy_send_timeout 7200s;
        proxy_read_timeout 7200s;
        send_timeout 7200s;
    }

    # ── WebSocket import (socket :3001) ─────────────────────────────────
    location /socket.io {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
    }

    # ── Frontend (Vite/nginx :9000) ───────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}

server {
    listen 80;
    server_name qldn.zsellers.com;
    return 301 https://$host$request_uri;
}
